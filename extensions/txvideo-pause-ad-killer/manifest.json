{
  "manifest_version": 3,
  "name": "腾讯视频暂停广告清理",
  "version": "1.0.0",
  "description": "自动隐藏腾讯视频（v.qq.com）播放暂停时插入的广告浮层，直接露出当前视频画面。",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": ["*://v.qq.com/*", "*://*.v.qq.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "腾讯视频暂停广告清理",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://v.qq.com/*", "*://*.v.qq.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
